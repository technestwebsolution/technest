---
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
import Layout from "../layouts/Layout.astro";
import Newsletter from "../components/Newsletter.astro";

const projects = [
  {
    title: "Perfume Direct – UK Online Fragrance & Beauty Store",
    category: "Shopify",
    image: "/images/work/perfume-direct.jpg",
  },
  {
    title: "Stealth Belt – Custom Ostomy Support Belts eCommerce Website",
    category: "Shopify",
    image: "/images/work/stealth-belt.jpg",
  },
  {
    title: "Perfumora – Wholesale Perfume eCommerce Website",
    category: "Shopify",
    image: "/images/work/perfumora.jpg",
  },
];
---

<Layout>
  <Header slot="header" />
  <main class="overflow-x-hidden text-white">
    <!-- Our Work Hero -->
    <section
      class="relative overflow-hidden px-5 pt-24 pb-28 lg:pt-20 lg:pb-20"
    >
      <!-- <div class="absolute inset-0 bg-[linear-gradient(180deg,#17284c_0%,#07111f_58%,#17294b_100%)]"></div> -->
      <div class="absolute right-0 top-20 h-[520px] w-[520px] rounded-full">
      </div>
      <!-- <div class="absolute bottom-0 left-0 h-32 w-full bg-[#17294b]"></div> -->

      <div class="relative z-10 mx-auto max-w-6xl px-4">
        <div class="text-center">
          <h1
            class="mt-8 font-lexend text-[25px] font-bold leading-[0.95] text-white lg:text-[70px]"
          >
            Our Work
          </h1>

          <div
            class="mt-4 font-montserrat text-[1.05rem] leading-7 text-white/92 sm:text-[1.1rem]"
          >
            <a
              href="/"
              class="text-cyan-400 transition-colors duration-150 hover:text-cyan-300"
            >
              Home
            </a>
            <span class="text-white/70">–</span>
            <span>Portfolio</span>
          </div>
        </div>

        <div class="mt-24 grid gap-6 md:grid-cols-3">
          {
            projects.map((project) => (
              <article class="overflow-hidden rounded-xl border border-white/10 bg-[#050a14] shadow-2xl">
                <div class="relative overflow-hidden p-2">
                  <img
                    src={project.image}
                    alt={project.title}
                    loading="lazy"
                    class="h-48 w-full rounded-lg object-cover"
                  />

                  <div class="absolute inset-2 rounded-lg bg-gradient-to-t from-black/30 to-transparent" />
                </div>

                <div class="px-3 pb-4 pt-1">
                  <h2 class="text-[15px] font-extrabold leading-snug md:text-base">
                    {project.title}
                  </h2>

                  <p class="mt-3 text-sm font-medium text-white/85">
                    {project.category}
                  </p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CTA Section with Fixed Image Effect -->
    <section class="relative bg-black">
      <div class="grid min-h-[360px] lg:grid-cols-2">
        <!-- Fixed Background Image -->
        <div
          data-fixed-image-box
          class="relative min-h-[320px] overflow-hidden bg-[url('/img/about_img.png')] bg-cover bg-center bg-fixed lg:min-h-[400px]"
        >
          <div class="absolute inset-0 bg-blue-600/25 mix-blend-screen"></div>
          <div
            class="absolute inset-0 bg-gradient-to-r from-black/5 to-black/50"
          >
          </div>
        </div>

        <!-- Text -->
        <div class="flex items-center bg-black px-6 py-16 md:px-16 lg:px-24">
          <div class="max-w-md">
            <a
              href="https://www.youtube.com/"
              target="_blank"
              aria-label="Play video"
              class="mb-7 flex h-14 w-14 items-center justify-center rounded-full border border-white/80 text-white hover:border-[#00e6ff] hover:bg-[#00e6ff] hover:text-black"
            >
              <svg class="ml-1 h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                <path d="M8 5v14l11-7z"></path>
              </svg>
            </a>

            <h2
              class="text-4xl font-extrabold leading-tight tracking-tight md:text-5xl"
            >
              Transform IT,<br />
              Save 30%!
            </h2>

            <p class="mt-6 text-xs font-semibold text-white/85">
              Add Your Heading Text Here
            </p>

            <a
              href="/contact"
              class="mt-5 inline-flex rounded-full bg-[linear-gradient(135deg,#27f4ef_0%,#10c0ff_100%)] px-8 py-3 text-sm font-bold text-black hover:bg-white"
            >
              Contact Us
            </a>
          </div>
        </div>
      </div>
    </section>
    <Newsletter />
  </main>

  <Footer />
</Layout>

<script>
  const fixedImageBoxes = document.querySelectorAll("[data-fixed-image-box]");

  const setFixedImagePosition = () => {
    fixedImageBoxes.forEach((box) => {
      const isMobile = window.innerWidth < 1024;

      if (isMobile) {
        box.style.backgroundAttachment = "scroll";
        box.style.backgroundPosition = "center center";
        return;
      }

      box.style.backgroundAttachment = "fixed";
      box.style.backgroundPosition = "left center";
      box.style.backgroundSize = "50vw auto";
    });
  };

  setFixedImagePosition();

  window.addEventListener("resize", setFixedImagePosition);
  document.addEventListener("astro:page-load", setFixedImagePosition);
</script>
