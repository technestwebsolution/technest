---
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
import Layout from "../layouts/Layout.astro";
import { workProjects } from "../lib/work";
---

<Layout
	title="Our Work | Technest Web Solution"
	description="A curated selection of recent web projects delivered by Technest Web Solution."
>
	<Header slot="header" />

	<main class="overflow-hidden text-white">
		<section
			class="relative isolate overflow-hidden px-5 pb-14 pt-5 lg:pb-20 lg:pt-10"
		>
			<div
				aria-hidden="true"
				class="pointer-events-none absolute inset-0"
			></div>

			<div class="relative mx-auto max-w-5xl">
				<!-- Heading -->
				<div class="mx-auto max-w-4xl text-center">
					<p
						class="text-sm font-bold uppercase tracking-[0.28em] text-cyan-300"
					>
						Our Portfolio
					</p>

					<h1
						class="mt-4 font-lexend text-[25px] font-bold leading-[0.95] text-white lg:text-[70px]"
					>
						Our Work
					</h1>

					<p
						class="mx-auto mt-6 max-w-3xl font-montserrat text-[1rem] leading-8 text-white/80 sm:text-[1.08rem]"
					>
						Explore a selection of recent projects. We build digital
						solutions that help businesses grow with stronger
						design, cleaner structure, and better performance.
					</p>
				</div>

				<!-- ================================
					PROJECT CARDS
				================================ -->
				<div
					class="
						mt-12
						grid
						grid-cols-1
						justify-items-center
						gap-7
						lg:grid-cols-2
					"
