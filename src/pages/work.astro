												project.features
													.slice(0, 3)
													.map(
														(
															feature,
															index,
														) => (
															<li
																class="
																	flex
																	translate-y-4
																	items-start
																	gap-4
																	rounded-xl
																	border
																	border-white/10
																	bg-white/[0.04]
																	p-4
																	opacity-0
