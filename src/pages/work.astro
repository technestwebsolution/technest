									group
									relative
									w-[400px]
									max-w-full
									overflow-hidden
									rounded-2xl
									border
									border-cyan-200/40
									bg-[#0b172a]
									shadow-[0_24px_90px_rgba(0,0,0,0.38)]
									transition-all
									duration-500

									hover:-translate-y-1
									hover:border-cyan-300/70
									hover:shadow-[0_28px_90px_rgba(34,211,238,0.12)]
								"
							>
								<!-- =================================
									NORMAL CARD CONTENT

									HOVER PAR:
									HIDE THASE
								================================= -->
								<div
									class="
										flex
										min-h-[560px]
										flex-col
										transition-all
										duration-500
										ease-in-out

										group-hover:scale-[0.96]
										group-hover:opacity-0
									"
								>
									<!-- IMAGE -->
									<div class="p-5 sm:p-6">
										<div
											class="
												relative
												flex
												lg:h-[575px]
												w-full
												items-center
												justify-center
												overflow-hidden
												rounded-2xl
												bg-transparent
                        h-full
											"
										>
											<img
												src={project.image}
												alt={project.alt}
												loading="lazy"
												class="
													h-full
													w-full
													object-contain
													object-center
													transition-transform
													duration-700
												"
											/>

											<!-- Category -->
											<div
												class="
													absolute
													left-4
													top-4
													inline-flex
													rounded-full
													border
													border-cyan-300/70
													bg-[#04101bf2]
													px-3
													py-1.5
													text-[0.70rem]
													font-bold
													uppercase
													tracking-[0.18em]
													text-cyan-300
