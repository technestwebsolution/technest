															d="M14.5 5.5c2.2 0 4 1.8 4 4 0 2.9-2.5 6.4-6.4 10.2-.7.7-1.9.5-2.3-.4l-1-2.1-2.1-1c-.9-.4-1.1-1.6-.4-2.3C8.1 9.1 11.6 6.5 14.5 6.5Z"
