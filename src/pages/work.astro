								>
									<div class="w-full">
										<!-- Small heading -->
										<p
											class="
												text-center
												text-xs
												font-bold
												uppercase
												tracking-[0.25em]
												text-cyan-300
											"
										>
											Key Features
										</p>

										<!-- Project Title -->
										<h3
											class="
												mt-3
												text-center
												font-lexend
												text-[1.7rem]
												font-extrabold
												text-white
											"
										>
											{project.title}
										</h3>

										<!-- Line -->
										<div
											class="
												mx-auto
												mt-5
												h-px
												w-16
												bg-cyan-300/50
											"
										></div>

										<!-- 3 FEATURES -->
										<ul class="mt-8 grid gap-4">
