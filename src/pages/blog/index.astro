---
import Header from "../../components/header.astro";
import Footer from "../../components/footer.astro";
import Layout from "../../layouts/Layout.astro";
import { blogPosts } from "../../lib/blog";

---

<Layout
  title="Blog | Technest Web Solution"
  description="Latest blog posts from Technest Web Solution."
>
  <Header slot="header" />

  <section class="relative isolate overflow-hidden px-5 py-12 text-white lg:py-16">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(31,197,255,0.12),transparent_45%),linear-gradient(180deg,#08111c_0%,#050b15_100%)]"
    ></div>

    <div class="relative mx-auto max-w-7xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="mb-5 text-sm font-bold uppercase tracking-[0.24em] text-cyan-300">
          Blog
        </p>
        <h1 class="font-lexend text-[clamp(2.4rem,6vw,4.5rem)] font-extrabold leading-[1.05]">
          Insights, updates and technical posts.
        </h1>
        <p class="mt-5 font-montserrat text-[1.02rem] leading-8 text-white/82">
          Browse the latest posts from our team and open each article for the full story.
        </p>
      </div>

      <div class="mt-12 grid gap-6 lg:grid-cols-2 xl:grid-cols-3">
        {blogPosts.map((post) => (
          <article class="group overflow-hidden border border-white/12 bg-[#06101e] transition-transform duration-200 hover:-translate-y-1">
            <div class="bg-[#d7cfc2] p-3">
              <div class="overflow-hidden">
                <img
                  src={post.image}
                  alt={post.alt}
                  class="h-[235px] w-full object-cover object-center transition-transform duration-500 group-hover:scale-[1.03] sm:h-[250px]"
                />
              </div>
            </div>

            <div class="px-5 pb-6 pt-4">
              <div class="flex items-center gap-2 text-[0.92rem] font-montserrat text-cyan-300">
                <span class="inline-flex h-4 w-4 items-center justify-center rounded-sm border border-cyan-300/60 text-[0.62rem] leading-none">
                  &#128197;
                </span>
                <span>{post.date}</span>
              </div>

              <h2 class="mt-3 max-w-[22rem] font-lexend text-[1.05rem] font-extrabold leading-7 text-white sm:text-[1.22rem] sm:leading-8">
                {post.title}
              </h2>

              <p class="mt-4 font-montserrat text-[0.95rem] leading-7 text-white/82 sm:text-[1rem]">
                {post.excerpt}
              </p>

              <a
                href={post.link}
                class="mt-5 inline-flex items-center gap-2 font-montserrat text-[0.95rem] font-bold text-cyan-300 transition-colors duration-150 group-hover:text-cyan-200"
              >
                <span>Read Post</span>
                <span aria-hidden="true" class="text-[1.1rem] leading-none transition-transform duration-150 group-hover:translate-x-1">
                  &rarr;
                </span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>
