<section
  id="about"
  class="relative isolate overflow-hidden px-5 py-16 text-white lg:py-10"
>
  <!-- <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_15%_15%,rgba(39,244,239,0.1),transparent_28%),radial-gradient(circle_at_85%_85%,rgba(16,192,255,0.08),transparent_26%)]"
  ></div> -->

  <div class="relative mx-auto max-w-7xl lg:px-10 px-0">
    <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.95fr)] lg:gap-10">
      <div class="relative overflow-hidden">
        <!-- <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(4,12,25,0.05)_0%,rgba(4,12,25,0.28)_100%)]"></div> -->
        <img
          src="/img/about-img.webp"
          alt="Development team working in office"
          class="w-full object-cover object-center"
        />
      </div>

      <div class="lg:pl-4">
        <div class="mb-5 flex items-center gap-3 text-[0.82rem] font-bold uppercase tracking-[0.18em] text-cyan-300">
          <span class="h-px w-5 bg-cyan-300/80"></span>
          <span>About Tech Nest Web Solution</span>
          <span class="h-px w-5 bg-cyan-300/80"></span>
        </div>

        <h2 class="font-lexend text-[25px] lg:text-[50px] font-bold leading-[1.10] text-white">
          Innovating Your Future with Technest
        </h2>

        <p class="mt-6 max-w-2xl font-montserrat text-[20px] leading-8 text-white/88">
          Your partner in digital innovation. Since 2022, Technest has excelled as a software development company, transforming ideas into powerful e-commerce, SaaS, and web solutions.
        </p>

        <p class="mt-5 max-w-2xl font-montserrat text-[20px] leading-8 text-white/88">
          Our skilled team, with deep expertise in PHP, Magento, Shopify, and Laravel, builds fast, reliable, and custom platforms tailored to your goals. With over 51+ successful projects for clients in retail, healthcare, and finance, we deliver results that help your business grow and succeed.
        </p>

        <a
          href="/about"
          class="mt-8 inline-flex min-h-[2.8rem] items-center justify-center rounded-full bg-[linear-gradient(135deg,#27f4ef_0%,#10c0ff_100%)] px-8 font-montserrat text-[1.03rem] font-bold text-[#00111b] transition-transform duration-150 hover:-translate-y-0.5 hover:brightness-105"
        >
          Know More
        </a>
      </div>
    </div>
  </div>
</section>
