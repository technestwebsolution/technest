---
const extraLinks = [
  { label: "Home", href: "/" },
  { label: "About Us", href: "/about" },
  { label: "Services", href: "/services" },
  { label: "Our Work", href: "/work" },
  { label: "Contact", href: "/contact" },
];

const services = [
  { label: "E-commerce Website Development", href: "/services" },
  { label: "Custom Web Development", href: "/services" },
  { label: "Web Development", href: "/services" },
  { label: "SaaS Development", href: "/services" },
  { label: "UI/UX Design", href: "/services" },
];
---

<footer class="relative isolate overflow-hidden px-5 pt-16 text-white lg:pt-5">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0"
  ></div>

  <div class="relative mx-auto max-w-7xl">
    <div class="h-px w-full bg-white/10"></div>

    <div class="grid gap-12 py-14 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.72fr)_minmax(0,0.95fr)_minmax(0,0.9fr)] lg:gap-14 lg:py-14">
      <div class="max-w-md">
        <a href="/" aria-label="Technest Web Solution home" class="inline-flex items-center gap-3">
          <img src="/img/logo_tech.svg" alt="TechNest Web Solution" class="h-20 w-auto" />
        </a>

        <p class="mt-8 max-w-sm font-montserrat text-[1rem] leading-7 text-white/90">
          We are a software development company helping businesses launch powerful web apps, e-commerce stores, and SaaS products. From idea to launch, we build digital solutions that deliver real results.
        </p>

        <div class="mt-8">
          <a
            href="https://www.linkedin.com/"
            target="_blank"
            rel="noreferrer"
            aria-label="Visit our LinkedIn profile"
            class="inline-flex h-11 w-11 items-center justify-center border border-white/55 text-[0.85rem] font-bold text-white transition-transform duration-150 hover:-translate-y-0.5 hover:border-cyan-300 hover:text-cyan-300"
          >
            in
          </a>
        </div>
      </div>

      <div>
        <h3 class="font-lexend text-[1.25rem] font-bold text-white sm:text-[1.5rem]">
          Extra Links
        </h3>

        <ul class="mt-8 space-y-3">
          {extraLinks.map((item) => (
            <li>
              <a
                href={item.href}
                class="inline-flex items-center gap-4 font-lexend text-[1.05rem] font-medium text-white transition-colors duration-150 hover:text-cyan-300"
              >
                <span class="inline-flex h-5 w-5 items-center justify-center rounded-full border border-cyan-400 text-[0.9rem] leading-none text-cyan-400">
                  ›
                </span>
                <span>{item.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="font-lexend text-[1.25rem] font-bold text-white sm:text-[1.5rem]">
          Services
        </h3>

        <ul class="mt-8 space-y-3">
          {services.map((item) => (
            <li>
              <a
                href={item.href}
                class="inline-flex items-start gap-4 font-lexend text-[1.05rem] font-medium leading-7 text-white transition-colors duration-150 hover:text-cyan-300"
              >
                <span class="mt-2 inline-flex h-5 w-5 flex-none items-center justify-center rounded-full border border-cyan-400 text-[0.9rem] leading-none text-cyan-400">
                  ›
                </span>
                <span>{item.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="font-lexend text-[1.25rem] font-bold text-white sm:text-[1.5rem]">
          Get in Touch
        </h3>

        <div class="mt-8 space-y-6 font-lexend text-[1.05rem] font-bold text-white">
          <a
            href="https://maps.google.com/?q=Ahmedabad,Gujarat"
            target="_blank"
            rel="noreferrer"
            class="flex items-start gap-4 transition-colors duration-150 hover:text-cyan-300"
          >
            <span class="mt-1 inline-flex h-5 w-5 flex-none items-center justify-center text-cyan-300">
              <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 fill-none stroke-current stroke-2">
                <path d="M12 21s6-6.2 6-12a6 6 0 1 0-12 0c0 5.8 6 12 6 12Z" />
                <circle cx="12" cy="9" r="2.2" />
              </svg>
            </span>
            <span>Ahmedabad,Gujarat</span>
          </a>

          <a
            href="mailto:hello@technestwebsolution.com"
            class="flex items-start gap-4 transition-colors duration-150 hover:text-cyan-300"
          >
            <span class="mt-1 inline-flex h-5 w-5 flex-none items-center justify-center text-cyan-300">
              <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 fill-none stroke-current stroke-2">
                <rect x="3" y="5" width="18" height="14" rx="2" />
                <path d="m4 7 8 6 8-6" />
              </svg>
            </span>
            <span>hello@technestwebsolution.com</span>
          </a>
        </div>
      </div>
    </div>

    <div class="h-px w-full bg-white/15"></div>

    <div class="flex flex-col items-center gap-4 py-7 text-center font-montserrat text-[0.95rem] text-white/85">
      <p>Technest Web Solution 2026 © All Rights Reserved</p>
    </div>
  </div>

  <a
    href="https://wa.me/918000000000"
    target="_blank"
    rel="noreferrer"
    aria-label="Chat on WhatsApp"
    class="fixed bottom-6 right-5 z-30 inline-flex h-16 w-16 items-center justify-center rounded-full bg-[#27c24c] text-white shadow-[0_16px_35px_rgba(0,0,0,0.35)] transition-transform duration-150 hover:-translate-y-1 hover:brightness-110"
  >
    <svg aria-hidden="true" viewBox="0 0 32 32" class="h-8 w-8 fill-current">
      <path d="M16 3C9.4 3 4 8.1 4 14.4c0 2.3.7 4.5 2 6.4L5 29l8.5-1.8c1.4.4 2.9.6 4.5.6 6.6 0 12-5.1 12-11.4S22.6 3 16 3Zm0 20.7c-1.5 0-3-.3-4.4-.8l-.3-.1-5.1 1.1 1.1-5-.2-.4c-1.1-1.6-1.7-3.4-1.7-5.3 0-5 4.4-9.1 10.6-9.1S26.6 8.2 26.6 13.2 22.2 23.7 16 23.7Zm6.1-7.3c-.3-.2-1.8-.9-2.1-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.2-1.1-.4-2.1-1.4-.8-.7-1.4-1.6-1.6-1.9-.2-.3 0-.5.1-.7l.4-.5c.1-.2.2-.3.3-.5.1-.2 0-.4 0-.6-.1-.1-.7-1.7-.9-2.3-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.1 1.1-1.1 2.7s1.2 3.1 1.4 3.3c.2.2 2.2 3.4 5.4 4.6.8.3 1.4.5 1.9.7.8.2 1.6.2 2.2.1.7-.1 1.8-.8 2-1.5.2-.7.2-1.3.1-1.5-.1-.2-.3-.3-.6-.4Z" />
    </svg>
  </a>
</footer>
