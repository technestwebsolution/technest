---
import { WORDPRESS_BLOG_EMPTY_STATE, fetchWordPressPosts } from "../lib/wp";

const posts = await fetchWordPressPosts(2);
---

<section
  id="blog"
  class="relative isolate overflow-hidden px-5 py-16 text-white lg:py-10"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0"
  ></div>

  <div class="relative mx-auto max-w-7xl">
    <div class="text-center">
      <div class="mb-5 flex items-center justify-center gap-3 text-[0.82rem] font-bold uppercase tracking-[0.18em] text-cyan-300">
        <span class="h-px w-5 bg-cyan-300/80"></span>
        <span>Latest Blog</span>
        <span class="h-px w-5 bg-cyan-300/80"></span>
      </div>

      <h2 class="mx-auto max-w-4xl font-lexend text-[32px] font-extrabold leading-[1.08] text-white sm:text-[44px] lg:text-[58px]">
        Real Solutions, Real Impact.
      </h2>

      <p class="mx-auto mt-5 max-w-3xl font-montserrat text-[0.98rem] leading-8 text-white/82 sm:text-[1.04rem]">
        Insights, tips and real-world case studies from the Technest team helping you make smarter technology decisions.
      </p>
    </div>

    {posts.length > 0 ? (
      <div class="mt-12 grid gap-6 lg:grid-cols-2 lg:max-w-[760px]">
        {posts.map((post) => (
          <article class="group overflow-hidden border border-white/12 bg-[#06101e] transition-transform duration-200 hover:-translate-y-1">
            <div class="bg-[#d7cfc2] p-3">
              <div class="overflow-hidden">
                <img
                  src={post.image}
                  alt={post.alt}
                  class="h-[235px] w-full object-cover object-center transition-transform duration-500 group-hover:scale-[1.03] sm:h-[250px]"
                />
              </div>
            </div>

            <div class="px-5 pb-6 pt-4">
              <div class="flex items-center gap-2 text-[0.92rem] font-montserrat text-cyan-300">
                <span class="inline-flex h-4 w-4 items-center justify-center rounded-sm border border-cyan-300/60 text-[0.62rem] leading-none">
                  &#128197;
                </span>
                <span>{post.date}</span>
              </div>

              <h3 class="mt-3 max-w-[22rem] font-lexend text-[1.05rem] font-extrabold leading-7 text-white sm:text-[1.22rem] sm:leading-8">
                {post.title}
              </h3>

              <p class="mt-4 font-montserrat text-[0.95rem] leading-7 text-white/82 sm:text-[1rem]">
                {post.excerpt}
              </p>

              <a
                href={post.link}
                class="mt-5 inline-flex items-center gap-2 font-montserrat text-[0.95rem] font-bold text-cyan-300 transition-colors duration-150 group-hover:text-cyan-200"
              >
                <span>Learn More</span>
                <span aria-hidden="true" class="text-[1.1rem] leading-none transition-transform duration-150 group-hover:translate-x-1">
                  &rarr;
                </span>
              </a>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="mx-auto mt-12 max-w-3xl border border-dashed border-cyan-300/30 bg-[#06101e] px-6 py-10 text-center">
        <p class="text-sm font-bold uppercase tracking-[0.22em] text-cyan-300">
          {WORDPRESS_BLOG_EMPTY_STATE.title}
        </p>
        <p class="mt-4 font-montserrat text-[1rem] leading-8 text-white/82">
          {WORDPRESS_BLOG_EMPTY_STATE.description}
        </p>
      </div>
    )}
  </div>
</section>
