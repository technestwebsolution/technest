---
const works = [
  {
    title: "Perfume Direct - UK Online Fragrance & Beauty Store",
    category: "Shopify",
    image: "/img/about-img.webp",
    alt: "Perfume Direct project preview",
  },
  {
    title: "Stealth Belt - Custom Ostomy Support Belts eCommerce Website",
    category: "Shopify",
    image: "/img/background_img.jpg",
    alt: "Stealth Belt project preview",
  },
  {
    title: "Perfumora - Wholesale Perfume eCommerce Website",
    category: "Shopify",
    image: "/img/logo_tech.svg",
    alt: "Perfumora project preview",
  },
];
---

<section
  id="work"
  class="relative isolate overflow-hidden px-5 py-16 text-white lg:py-24"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0"
  ></div>

  <div class="relative mx-auto max-w-7xl">
    <div class="text-center">
      <div class="mb-5 flex items-center justify-center gap-3 text-[0.82rem] font-bold uppercase tracking-[0.18em] text-cyan-300">
        <span class="h-px w-5 bg-cyan-300/80"></span>
        <span>Our Work</span>
        <span class="h-px w-5 bg-cyan-300/80"></span>
      </div>

      <h2 class="mx-auto font-lexend text-[32px] font-extrabold leading-[1.08] text-white sm:text-[44px] lg:text-[58px]">
        Crafted Solutions That Perform.
      </h2>

      <p class="mt-5 max-w-4xl mx-auto font-montserrat text-[20px] leading-8 text-white/88">
        Each project we deliver is driven by clarity, usability, and performance. From concept to launch, we focus on outcomes that help brands grow with confidence.
      </p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      {works.map((work) => (
        <article class="group overflow-hidden rounded-[1.35rem] border border-white/12 bg-[#06101e] shadow-[0_24px_70px_rgba(0,0,0,0.28)] transition-transform duration-200 hover:-translate-y-1">
          <div class="relative overflow-hidden bg-[#d7d0c4] p-3">
            <div class="overflow-hidden rounded-[0.95rem]">
              <img
                src={work.image}
                alt={work.alt}
                class="h-[280px] w-full object-cover object-center transition-transform duration-500 group-hover:scale-[1.03] sm:h-[310px] lg:h-[300px]"
              />
            </div>
          </div>

          <div class="px-5 pb-6 pt-5">
            <h3 class="max-w-[20rem] font-lexend text-[1.08rem] font-extrabold leading-8 text-white sm:text-[1.18rem]">
              {work.title}
            </h3>

            <p class="mt-3 font-montserrat text-[0.95rem] leading-6 text-white/78">
              {work.category}
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
