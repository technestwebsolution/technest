---
import { workProjects } from "../lib/work";

const featuredWorks = workProjects.slice(0, 3);
---

<section
  id="work"
  class="relative isolate overflow-hidden px-5 py-16 text-white lg:py-10"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0"
  ></div>

  <div class="relative mx-auto max-w-7xl">
    <div class="text-center">
      <div class="mb-5 flex items-center justify-center gap-3 text-[0.82rem] font-bold uppercase tracking-[0.18em] text-cyan-300">
        <span class="h-px w-5 bg-cyan-300/80"></span>
        <span>Our Work</span>
        <span class="h-px w-5 bg-cyan-300/80"></span>
      </div>

      <h2 class="mx-auto font-lexend text-[32px] font-extrabold leading-[1.08] text-white sm:text-[44px] lg:text-[58px]">
        Crafted Solutions That Perform.
      </h2>

      <p class="mt-5 max-w-4xl mx-auto font-montserrat text-[20px] leading-8 text-white/88">
        Each project we deliver is driven by clarity, usability, and performance. From concept to launch, we focus on outcomes that help brands grow with confidence.
      </p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      {featuredWorks.map((project) => (
        <article class="group relative overflow-hidden rounded-[1.6rem] border border-cyan-200/25 bg-[#0b172a] shadow-[0_24px_90px_rgba(0,0,0,0.34)] transition-all duration-500 hover:-translate-y-1 hover:border-cyan-300/60 hover:shadow-[0_28px_90px_rgba(34,211,238,0.12)]">
          <div class="relative flex h-full min-h-[560px] flex-col transition-all duration-500 ease-in-out group-hover:scale-[0.96] group-hover:opacity-0">
            <div class="p-5 sm:p-6">
              <div class="relative flex h-full min-h-[320px] w-full items-center justify-center overflow-hidden rounded-2xl bg-transparent sm:min-h-[380px] lg:min-h-[420px]">
                <img
                  src={project.image}
                  alt={project.alt}
                  loading="lazy"
                  class="h-full w-full object-contain object-center transition-transform duration-700 group-hover:scale-[1.03]"
                />

                <div class="absolute left-4 top-4 inline-flex rounded-full border border-cyan-300/70 bg-[#04101bf2] px-3 py-1.5 text-[0.7rem] font-bold uppercase tracking-[0.18em] text-cyan-300 shadow-[0_10px_30px_rgba(0,0,0,0.22)]">
                  {project.category}
                </div>
              </div>
            </div>

            <div class="flex flex-1 flex-col px-5 pb-6 pt-0">
              <div class="flex items-start gap-4">
                <div class="min-w-0 flex-1">
                  <h3 class="font-lexend text-[1.18rem] font-extrabold leading-tight text-white sm:text-[1.4rem]">
                    {project.title}
                  </h3>

                  <p class="mt-3 font-montserrat text-[0.96rem] leading-6 text-white/80 text-justify">
                    {project.description}
                  </p>
                </div>
              </div>

              <div class="mt-auto pt-6">
                <a
                  href="/contact"
                  class="inline-flex items-center gap-2 rounded-full border border-cyan-300/55 px-4 py-2.5 text-sm font-bold text-cyan-300 transition-all duration-300 hover:border-cyan-300 hover:bg-cyan-300 hover:text-[#06101f]"
                >
                  <span>View Case Study</span>
                  <span aria-hidden="true" class="text-[1rem] leading-none">&rarr;</span>
                </a>
              </div>
            </div>
          </div>

          <div class="pointer-events-none absolute inset-0 z-20 flex scale-[1.04] items-center justify-center bg-[#071525]/95 p-8 opacity-0 backdrop-blur-sm transition-all duration-500 ease-out group-hover:scale-100 group-hover:opacity-100">
            <div class="w-full">
              <p class="text-center text-xs font-bold uppercase tracking-[0.25em] text-cyan-300">
                Key Features
              </p>

              <h3 class="mt-3 text-center font-lexend text-[1.5rem] font-extrabold text-white">
                {project.title}
              </h3>

              <div class="mx-auto mt-5 h-px w-16 bg-cyan-300/50"></div>

              <ul class="mt-8 grid gap-4">
                {project.features.slice(0, 3).map((feature, index) => (
                  <li
                    class="flex translate-y-4 items-start gap-4 rounded-xl border border-white/10 bg-white/[0.04] p-4 opacity-0 transition-all duration-500 group-hover:translate-y-0 group-hover:opacity-100"
                    style={`transition-delay: ${100 + index * 100}ms`}
                  >
                    <span class="mt-[2px] flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-cyan-300/60 bg-cyan-300/10 text-xs font-black text-cyan-300">
                      &#10003;
                    </span>

                    <span class="font-montserrat text-[0.95rem] font-medium leading-6 text-white/90">
                      {feature}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
