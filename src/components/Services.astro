---
const services = [
  {
    title: "E-commerce Website Development",
    description:
      "We develop powerful e-commerce websites using Magento, PHP, Shopify, WooCommerce, and BigCommerce. Our tailored solutions deliver seamless shopping experiences, optimized for conversions and scalability to grow your online business.",
    href: "/contact?service=ecommerce#contact",
    icon: "storefront",
  },
  {
    title: "Custom Web Development",
    description:
      "Our team builds dynamic, high-performance web applications with Laravel, React.js, Node.js, Next.js, and Vue.js. We create custom solutions that align with your goals, ensuring speed, reliability, and flexibility.",
    href: "/contact?service=custom-web-development#contact",
    icon: "code",
  },
  {
    title: "Web Development",
    description:
      "Using flexible content platforms, we build responsive and user-friendly websites that elevate your online presence. Our solutions prioritize performance and ease of management to meet your business needs.",
    href: "/contact?service=web-development#contact",
    icon: "monitor",
  },
  {
    title: "SaaS Development",
    description:
      "We design secure, scalable SaaS platforms tailored to your business. Our expertise delivers reliable, cloud-ready solutions that support growth and streamline operations for long-term success.",
    href: "/contact?service=saas-development#contact",
    icon: "cloud",
  },
  {
    title: "UI/UX Design",
    description:
      "Our user-focused designs create intuitive, engaging interfaces for web and e-commerce platforms. We prioritize clarity and responsiveness to enhance user experiences and drive engagement.",
    href: "/contact?service=ui-ux-design#contact",
    icon: "ux",
  },
];

const iconPaths = {
  storefront:
    "M5 11V6.5A1.5 1.5 0 0 1 6.5 5h11A1.5 1.5 0 0 1 19 6.5V11M5 11h14M5 11l1.2 7.2A1.5 1.5 0 0 0 7.68 20h8.64a1.5 1.5 0 0 0 1.48-1.3L19 11M8 11v1.5a2 2 0 0 0 4 0V11M12 11v1.5a2 2 0 0 0 4 0V11",
  code: "M9 18 3 12l6-6M15 6l6 6-6 6M14 4 10 20",
  monitor:
    "M4 6.5A1.5 1.5 0 0 1 5.5 5h13A1.5 1.5 0 0 1 20 6.5v8A1.5 1.5 0 0 1 18.5 16H5.5A1.5 1.5 0 0 1 4 14.5v-8ZM8 19h8M10 16v3M14 16v3",
  cloud: "M7 18a4 4 0 1 1 .9-7.9A5 5 0 0 1 17 11a3.5 3.5 0 0 1 0 7H7Z",
  ux: "M7 4h10a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm0 4h10M8 8.5h2M12 8.5h2M16 8.5h1M9 12h6M9 15h4",
};
---

<section
  id="services"
  class="relative isolate overflow-hidden bg-transparent px-5 pt-10 lg:pt-20 text-white"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-15"
  >
  </div>

  <div class="relative mx-auto max-w-7xl">
    <div
      class="grid gap-10 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,0.9fr)] lg:items-end"
    >
      <div>
        <div
          class="mb-4 flex items-center gap-3 text-[0.82rem] font-bold uppercase tracking-[0.18em] text-cyan-300"
        >
          <span class="h-px w-5 bg-cyan-300/80"></span>
          <span>Our Services</span>
          <span class="h-px w-5 bg-cyan-300/80"></span>
        </div>

        <h2
          class="max-w-3xl font-lexend text-[25px] lg:text-[55px] font-bold leading-[1.05] text-white"
        >
          Innovate and Grow with Our Software Solutions
        </h2>
      </div>

      <p
        class="max-w-xl font-montserrat text-[1rem] leading-7 text-white/82 sm:text-[1.06rem]"
      >
        From custom applications to e-commerce platforms, our software
        development services drive your business success.
      </p>
    </div>

    <div class="mt-12 grid gap-8 lg:grid-cols-3">
      {
        services.slice(0, 3).map((service) => (
          <article class="group min-h-[335px] bg-[#2b4474] px-7 py-8 shadow-[0_20px_50px_rgba(0,0,0,0.2)] transition-transform duration-200 hover:-translate-y-1">
            <div class="mb-8 inline-flex h-14 w-14 items-center justify-center text-white">
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                class="h-20 w-20 fill-none stroke-current stroke-[1.8]"
              >
                <path
                  d={iconPaths[service.icon]}
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </div>

            <h3 class="font-lexend text-[1.08rem] lg:text-[24px] font-bold leading-7 text-white">
              {service.title}
            </h3>

            <p class="mt-4 font-montserrat text-[18px] leading-7 text-white/92">
              {service.description}
            </p>

            <a
              href={service.href}
              class="mt-6 inline-flex items-center gap-2 font-montserrat text-[17px] font-bold text-cyan-300 transition-colors duration-150 group-hover:text-cyan-200"
            >
              <span>Learn More</span>
              <span
                aria-hidden="true"
                class="text-[1.25rem] leading-none transition-transform duration-150 group-hover:translate-x-1"
              >
                &rarr;
              </span>
            </a>
          </article>
        ))
      }
    </div>

    <div class="mt-8 grid gap-8 lg:grid-cols-2 lg:max-w-4xl lg:px-10 lg:mx-auto">
      {
        services.slice(3).map((service) => (
          <article class="group min-h-[335px] bg-[#2b4474] px-7 py-8 shadow-[0_20px_50px_rgba(0,0,0,0.2)] transition-transform duration-200 hover:-translate-y-1">
            <div class="mb-8 inline-flex h-14 w-14 items-center justify-center text-white">
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                class="h-20 w-20 fill-none stroke-current stroke-[1.8]"
              >
                <path
                  d={iconPaths[service.icon]}
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </div>

            <h3 class="font-lexend text-[1.08rem] lg:text-[24px] font-bold leading-7 text-white">
              {service.title}
            </h3>

            <p class="mt-4 font-montserrat text-[18px] leading-7 text-white/92">
              {service.description}
            </p>

            <a
              href={service.href}
              class="mt-6 inline-flex items-center gap-2 font-montserrat text-[17px] font-bold text-cyan-300 transition-colors duration-150 group-hover:text-cyan-200"
            >
              <span>Learn More</span>
              <span
                aria-hidden="true"
                class="text-[14px] leading-none transition-transform duration-150 group-hover:translate-x-1"
              >
                &rarr;
              </span>
            </a>
          </article>
        ))
      }
    </div>
  </div>
  <div class="justify-center mt-10 text-center">
    <a
      href="/services#services"
      class="mt-10 relative w-50 font-montserrat z-10 mt-4 inline-flex items-center justify-center gap-3 rounded-full bg-[linear-gradient(135deg,#27f4ef_0%,#10c0ff_100%)] px-6 py-3 font-bold text-[#00111b] transition-transform duration-150 hover:-translate-y-0.5 hover:brightness-105"
    >
      <span>See All Services</span>
    </a>
  </div>
</section>
