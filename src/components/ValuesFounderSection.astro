---
const values = [
  {
    title: "Agility",
    text: "We adapt quickly to your needs, building flexible PHP-driven platforms to keep your business ahead in a fast-changing digital world.",
  },
  {
    title: "Client-First",
    text: "Your goals drive us. We create user-friendly solutions that boost sales and engagement, exceeding your expectations every time.",
  },
  {
    title: "Excellence",
    text: "We deliver exceptional e-commerce and SaaS platforms with unmatched quality, ensuring reliable, user-friendly solutions that drive your success.",
  },
];
---

<section
  class="overflow-hidden px-5 lg:px-0 py-16 max-w-7xl mx-auto "
>
  <div
    class="mx-auto grid grid-cols-1 items-center gap-12 xl:grid-cols-[1fr_350px] 2xl:gap-[50px]"
  >
    <!-- Cards -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        values.map((item) => (
          <article class="min-h-[260px] bg-[linear-gradient(180deg,#06101f_0%,#233c70_100%)] px-7 py-10 sm:px-9 md:min-h-[310px] md:px-8 md:pt-20 lg:px-6">
            <h3 class="mb-5 text-[26px] font-extrabold leading-[1.1] tracking-[-1px] text-white md:mb-6 lg:text-[25px]">
              {item.title}
            </h3>

            <p class="mt-6 max-w-2xl font-montserrat text-[17px] leading-6 text-white/88 lg:text-[16px]">
              {item.text}
            </p>
          </article>
        ))
      }
    </div>

    <!-- Founder Quote -->
    <div class=" text-white xl:max-w-none">
      <h2
        class="mb-8 text-[26px] font-extrabold leading-[1.3] tracking-[-1px] text-white"
      >
        ” We don’t just adapt to <br class="hidden sm:block" />
        the future; we shape it with <br class="hidden sm:block" />
        innovation. ”
      </h2>

      <div class="flex items-center gap-5 sm:gap-6">
        <img
          src="/img/about_img.png"
          alt="Richa Shah"
          class="h-[76px] w-[76px] rounded-full object-cover sm:h-[90px] sm:w-[90px] lg:h-[95px] lg:w-[95px]"
          loading="lazy"
        />

        <div>
          <h4 class="mb-1 text-[22px] font-extrabold leading-tight tracking-[-0.7px] text-white sm:text-[25px]">
            Richa Shah
          </h4>

          <p class="text-[19px] font-medium leading-none tracking-[-0.4px] text-[#00f5e0] sm:text-[22px]">
            Founder
          </p>
        </div>
      </div>
    </div>
  </div>
</section>