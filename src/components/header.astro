---
const navItems = [
  { href: "/", label: "Home" },
  { href: "#about", label: "About" },
  { href: "services", label: "Services" },
  { href: "#work", label: "Our Work" },
  { href: "#contact", label: "Contact" },
];
---

<header class="relative overflow-hidden bg-[#06101b] text-white">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(0,255,255,0.09),transparent_28%),linear-gradient(180deg,#07111f_0%,#06101b_100%)]"
  ></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-20 [background-image:linear-gradient(30deg,rgba(31,197,255,0.18)_12%,transparent_12.5%,transparent_87%,rgba(31,197,255,0.18)_87.5%,rgba(31,197,255,0.18)),linear-gradient(150deg,rgba(31,197,255,0.18)_12%,transparent_12.5%,transparent_87%,rgba(31,197,255,0.18)_87.5%,rgba(31,197,255,0.18)),linear-gradient(90deg,rgba(31,197,255,0.12)_2%,transparent_2%,transparent_98%,rgba(31,197,255,0.12)_98%)] [background-size:54px_94px] [background-position:center] [mask-image:linear-gradient(180deg,rgba(0,0,0,0.8),transparent_92%)]"
  ></div>

  <div class="relative border-b border-white/[0.15] backdrop-blur-md px-5">
    <div class="mx-auto flex min-h-16 mx-auto max-w-7xl lg:flex-wrap items-center justify-between gap-4 py-3 text-[0.98rem] text-white/[0.95] sm:min-h-16 px-5">
      <div class="flex flex-wrap items-center gap-3 sm:gap-4">
        <a
          href="https://maps.google.com/?q=Ahmedabad,Gujarat"
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center gap-2 text-white/[0.95] transition-colors duration-150 hover:text-cyan-300"
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 text-cyan-300 fill-current">
            <path d="M12 2C8.14 2 5 5.14 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.86-3.14-7-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5Z" />
          </svg>
          <span>Ahmedabad, Gujarat</span>
        </a>

        <span class="hidden h-5 w-px bg-white/[0.2] md:block" aria-hidden="true"></span>

        <a
          href="mailto:hello@technestwebsolution.com"
          class="inline-flex items-center gap-2 text-white/[0.95] transition-colors duration-150 hover:text-cyan-300"
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 text-cyan-300 fill-none stroke-current stroke-2">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m4 7 8 6 8-6" />
          </svg>
          <span>hello@technestwebsolution.com</span>
        </a>
      </div>

      <a
        href="https://www.linkedin.com/"
        target="_blank"
        rel="noreferrer"
        aria-label="Visit our LinkedIn profile"
        class="inline-flex h-11 w-11 items-center justify-center border border-white/[0.6] text-sm font-bold tracking-[-0.02em] text-white transition-transform duration-150 hover:-translate-y-0.5 hover:border-cyan-300 hover:text-cyan-300"
      >
        in
      </a>
    </div>
  </div>

  <div class="relative">
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 py-4 lg:min-h-[100px] px-5">
      <a href="/" aria-label="Technest Web Solution home" class="inline-flex items-center gap-3 text-white no-underline">
        <!-- <span
          aria-hidden="true"
          class="grid h-16 w-16 place-items-center rounded-[1.15rem] bg-[radial-gradient(circle_at_30%_30%,rgba(76,241,255,0.95),transparent_44%),linear-gradient(135deg,#0df2f2_0%,#0c89ff_47%,#7b2cff_100%)] shadow-[0_18px_36px_rgba(0,0,0,0.35)] sm:h-[4rem] sm:w-[4rem]"
        >
          <span class="h-9 w-9 rounded-full border-[3px] border-[#07111fb8] shadow-[inset_0_0_0_0.3rem_rgba(255,255,255,0.18),0_0_0_0.12rem_rgba(255,255,255,0.24)] sm:h-9 sm:w-9"></span>
        </span> -->
        <img src="/img/logo_tech.svg" alt="TechNest Web Solution Logo" class="h-20 w-auto" />

        <!-- <span class="flex flex-col leading-none">
          <strong class="text-sm font-extrabold uppercase tracking-[0.08em] sm:text-[1.1rem]">TechNest</strong>
          <small class="mt-1 text-[0.72rem] uppercase tracking-[0.14em] text-white/[0.7] sm:text-[0.8rem]">Web Solution</small>
        </span> -->
      </a>

      <nav aria-label="Primary navigation" class="mx-auto hidden items-center gap-[clamp(1rem,2.5vw,2.4rem)] lg:flex">
        {navItems.map((item) => (
          <a
            href={item.href}
          class="text-[1.20rem] font-bold text-white/[0.92] no-underline transition-colors duration-150 hover:text-cyan-300"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <a
        href="#contact"
        class="hidden min-h-[2.95rem] items-center justify-center gap-3 rounded-full bg-[linear-gradient(135deg,#27f4ef_0%,#10c0ff_100%)] px-8 text-[1.02rem] font-bold font-montserrat text-[#00111b] transition-transform duration-150 hover:-translate-y-0.5 hover:brightness-105 lg:inline-flex"
      >
        <span>Get a Quote</span>
        <span aria-hidden="true" class="text-[1.45rem] leading-none">&gt;</span>
      </a>

      <details class="relative ml-auto lg:hidden">
        <summary class="list-none cursor-pointer rounded-[0.95rem] border border-white/[0.15] bg-white/[0.05] p-3 text-white/[0.9] [&::-webkit-details-marker]:hidden">
          <span class="flex flex-col gap-1">
            <span class="block h-0.5 w-5 rounded-full bg-current"></span>
            <span class="block h-0.5 w-5 rounded-full bg-current"></span>
            <span class="block h-0.5 w-5 rounded-full bg-current"></span>
          </span>
        </summary>

        <div class="absolute right-0 top-[calc(100%+0.75rem)] z-20 w-[min(19rem,calc(100vw-2rem))] rounded-[1.2rem] border border-white/[0.15] bg-[#06101bf5] p-4 shadow-[0_24px_50px_rgba(0,0,0,0.35)] backdrop-blur-xl">
          <nav aria-label="Mobile navigation" class="grid gap-1">
            {navItems.map((item) => (
              <a
                href={item.href}
                class="rounded-[0.85rem] px-4 py-3 font-bold text-white no-underline transition-colors duration-150 hover:bg-white/[0.07] hover:text-cyan-300"
              >
                {item.label}
              </a>
            ))}
          </nav>

          <a
            href="#contact"
            class="mt-4 inline-flex w-full items-center justify-center gap-3 rounded-full bg-[linear-gradient(135deg,#27f4ef_0%,#10c0ff_100%)] px-6 py-4 font-bold text-[#00111b] transition-transform duration-150 hover:-translate-y-0.5 hover:brightness-105 font-montserrat"
          >
            <span>Get a Quote</span>
            <span aria-hidden="true" class="text-[1.45rem] leading-none">&gt;</span>
          </a>
        </div>
      </details>
    </div>
  </div>
</header>
