---
---

<section
  id="contact"
  class="relative isolate overflow-hidden px-5 py-16 text-white lg:py-10"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0"
  ></div>

  <!-- <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-25 [background-image:linear-gradient(30deg,rgba(255,255,255,0.05)_12%,transparent_12.5%,transparent_87%,rgba(255,255,255,0.05)_87.5%,rgba(255,255,255,0.05)),linear-gradient(150deg,rgba(255,255,255,0.05)_12%,transparent_12.5%,transparent_87%,rgba(255,255,255,0.05)_87.5%,rgba(255,255,255,0.05)),linear-gradient(90deg,rgba(255,255,255,0.03)_2%,transparent_2%,transparent_98%,rgba(255,255,255,0.03)_98%)] [background-size:56px_96px] [background-position:center] [mask-image:linear-gradient(180deg,rgba(0,0,0,0.8),transparent_95%)]"
  ></div> -->

  <div class="relative mx-auto max-w-7xl">
    <div class="grid items-start gap-10 lg:grid-cols-2 lg:gap-16">
      <div class="bg-[linear-gradient(180deg,#223a6f_0%,#17284f_100%)] px-6 py-10 shadow-[0_26px_70px_rgba(0,0,0,0.26)] sm:px-10 sm:py-12 lg:px-12 lg:py-12">
        <h2 class="font-lexend text-[2rem] font-bold leading-tight text-white sm:text-[2.4rem]">
          Send Us a Message
        </h2>

        <form
          class="mt-11 grid gap-8"
          action="mailto:hello@technestwebsolution.com"
          method="post"
          enctype="text/plain"
          data-contact-form
        >
          <div class="grid gap-7">
            <div class="grid gap-2">
              <input
                id="contact-name"
                name="name"
                type="text"
                autocomplete="name"
                placeholder="Name"
                required
                class="w-full border-0 border-b border-white/28 bg-transparent pb-3 font-montserrat text-[0.98rem] text-white outline-none transition-colors duration-150 placeholder:text-white/50 focus:border-cyan-300 focus:ring-0"
              />
            </div>

            <div class="grid gap-2">
              <input
                id="contact-email"
                name="email"
                type="email"
                autocomplete="email"
                placeholder="Email"
                required
                class="w-full border-0 border-b border-white/28 bg-transparent pb-3 font-montserrat text-[0.98rem] text-white outline-none transition-colors duration-150 placeholder:text-white/50 focus:border-cyan-300 focus:ring-0"
              />
            </div>

            <div class="grid gap-2">
              <input
                id="contact-phone"
                name="phone"
                type="tel"
                autocomplete="tel"
                placeholder="Phone Number"
                class="w-full border-0 border-b border-white/28 bg-transparent pb-3 font-montserrat text-[0.98rem] text-white outline-none transition-colors duration-150 placeholder:text-white/50 focus:border-cyan-300 focus:ring-0"
              />
            </div>

            <div class="grid gap-2 pt-1">
              <textarea
                id="contact-message"
                name="message"
                rows="8"
                placeholder="How can we help you? Feel free to get in touch."
                required
                class="mt-4 h-[150px] w-full resize-none border-0 border-b border-white/28 bg-transparent pb-3 font-montserrat text-[0.98rem] text-white outline-none transition-colors duration-150 placeholder:text-white/50 focus:border-cyan-300 focus:ring-0"
              ></textarea>
            </div>
          </div>

          <div class="mt-1 flex items-start gap-3">
            <input
              id="contact-consent"
              name="consent"
              type="checkbox"
              required
              class="mt-1 h-4 w-4 rounded border-white/35 bg-transparent text-cyan-300 focus:ring-cyan-300"
            />
            <label for="contact-consent" class="font-montserrat text-[0.92rem] leading-6 text-white/88">
              I agree that my data is collected and stored.
              <span class="text-[#ff6b6b]">*</span>
            </label>
          </div>

          <button
            type="submit"
            class="mt-1 inline-flex min-w-[10.5rem] items-center justify-center rounded-full bg-[linear-gradient(135deg,#27f4ef_0%,#10c0ff_100%)] px-8 py-3.5 font-montserrat text-[1rem] font-bold text-[#00111b] transition-transform duration-150 hover:-translate-y-0.5 hover:brightness-105"
          >
            Send Message
          </button>
        </form>
      </div>

      <div class="pt-8 lg:pt-20">
        <div class="mb-6 flex items-center gap-2 text-[0.86rem] font-bold uppercase tracking-[0.18em] text-cyan-300">
          <span class="text-white/80">|</span>
          <span>Contact Us</span>
          <span class="text-white/80">|</span>
        </div>

        <h2 class="max-w-xl font-lexend text-[25px] font-bold leading-[1.15] text-white lg:max-w-[620px] lg:text-[50px]">
          Your IT Solution <br/> Starts Here.
        </h2>

        <p class="mt-6 max-w-[640px] font-montserrat text-[1rem] leading-7 text-white/82 sm:text-[1.05rem]">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut elit tellus, luctus nec ullamcorper mattis, pulvinar dapibus leo.
        </p>

        <div class="mt-8">
          <h3 class="font-lexend text-[1.45rem] font-bold text-white">
            Get in Touch
          </h3>

          <div class="mt-6 space-y-4 font-montserrat text-[1rem] leading-7 text-white/94">
            <a
              href="https://maps.google.com/?q=Ahmedabad,Gujarat"
              target="_blank"
              rel="noreferrer"
              class="block transition-colors duration-150 hover:text-cyan-300"
            >
              Ahmedabad, Gujarat
            </a>

            <a
              href="mailto:hello@technestwebsolution.com"
              class="block font-semibold transition-colors duration-150 hover:text-cyan-300"
            >
              hello@technestwebsolution.com
            </a>
          </div>

          <div class="mt-6">
            <a
              href="https://in.linkedin.com/in/richa-shah-b98380182"
              target="_blank"
              rel="noreferrer"
              aria-label="Visit our LinkedIn profile"
              class="inline-flex h-7 w-7 items-center justify-center border border-white/60 text-[0.72rem] font-bold text-white transition-transform duration-150 hover:-translate-y-0.5 hover:border-cyan-300 hover:text-cyan-300"
            >
              in
            </a>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.querySelectorAll("[data-contact-form]").forEach((form) => {
    form.addEventListener("submit", (event) => {
      event.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const data = new FormData(form);
      const subject = `New project enquiry from ${data.get("name")}`;
      const body = [
        `Name: ${data.get("name")}`,
        `Email: ${data.get("email")}`,
        `Phone: ${data.get("phone") || "Not provided"}`,
        "",
        `Message:\n${data.get("message")}`,
      ].join("\n");

      window.location.href = `mailto:hello@technestwebsolution.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });
  });
</script>
