---
const testimonials = [
  {
    name: "Rajat Khandelwal",
    role: "Founder, Retail Brand",
    company: "India",
    quote:
      "Amazing team and very strong communication. Technest understood our goals quickly and delivered a clean, fast platform that improved conversions within weeks.",
    rating: 5,
    accent: "from-[#27f4ef] to-[#10c0ff]",
    initials: "RK",
  },
  {
    name: "Sophia Mitchell",
    role: "Operations Director",
    company: "UK",
    quote:
      "The team handled design, development, and launch with real precision. They kept us updated at every step and solved issues before they became problems.",
    rating: 5,
    accent: "from-[#7f54b3] to-[#10c0ff]",
    initials: "SM",
  },
  {
    name: "Daniel Brooks",
    role: "CTO, SaaS Startup",
    company: "US",
    quote:
      "We needed a scalable product fast. Technest delivered a stable architecture, modern UI, and an implementation pace that kept our roadmap moving.",
    rating: 5,
    accent: "from-[#f76f1c] to-[#27f4ef]",
    initials: "DB",
  },
  {
    name: "Ayesha Khan",
    role: "Marketing Lead",
    company: "UAE",
    quote:
      "Clear thinking, strong execution, and a polished result. The new experience looks premium and has already improved engagement across our campaigns.",
    rating: 5,
    accent: "from-[#95bf47] to-[#10c0ff]",
    initials: "AK",
  },
];
---

<section
  id="testimonials"
  class="relative isolate overflow-hidden px-5 py-20 text-white sm:py-24 lg:py-12"
>
  <!-- <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_12%_18%,rgba(39,244,239,0.12),transparent_26%),radial-gradient(circle_at_90%_70%,rgba(16,192,255,0.1),transparent_30%),linear-gradient(180deg,rgba(5,17,36,0.35),rgba(4,12,28,0.8))]"
  ></div> -->

  <div class="relative mx-auto max-w-7xl">
    <div class="grid items-end gap-8 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] lg:gap-16">
      <div>
        <div class="mb-5 flex items-center gap-3 text-[0.78rem] font-bold uppercase tracking-[0.24em] text-cyan-300">
          <span class="h-px w-7 bg-cyan-300/80"></span>
          <span>What Our Clients Say</span>
          <span class="h-px w-7 bg-cyan-300/80"></span>
        </div>

        <h2 class="max-w-2xl font-lexend text-[2.45rem] font-extrabold leading-[1.08] text-white sm:text-[3.5rem] lg:text-[3.2rem]">
          Our Work.<br />
          <span class="text-cyan-300">Their Words.</span>
        </h2>
      </div>

      <p class="max-w-xl font-montserrat text-[1rem] leading-8 text-white/70 lg:justify-self-end lg:pb-2 lg:text-[1.05rem]">
        Don&apos;t just take our word for it. Hear directly from the businesses we&apos;ve helped build, launch, and grow their digital platforms.
      </p>
    </div>

    <div class="mt-12 grid gap-7 lg:grid-cols-[minmax(0,0.78fr)_minmax(0,1.22fr)] lg:gap-8">
      <div class="relative overflow-hidden rounded-[1.75rem] border border-cyan-300/20 bg-[#0a1b37]/90 p-7 shadow-[0_24px_70px_rgba(0,0,0,0.22)] sm:p-9">
        <div aria-hidden="true" class="absolute -right-16 -top-16 h-44 w-44 rounded-full bg-cyan-300/10 blur-3xl"></div>

        <div class="relative flex items-end justify-between gap-5">
          <div>
            <p class="font-montserrat text-sm font-semibold uppercase tracking-[0.16em] text-white/55">
              Client satisfaction
            </p>
            <div class="mt-3 flex items-end gap-3">
              <span class="font-lexend text-[4.5rem] font-black leading-none text-white">4.9</span>
              <span class="pb-2 font-montserrat text-sm font-semibold text-white/55">/ 5.0</span>
            </div>
          </div>

          <div class="grid h-14 w-14 place-items-center rounded-2xl border border-cyan-300/25 bg-cyan-300/10 text-cyan-300">
            <svg aria-hidden="true" viewBox="0 0 24 24" class="h-7 w-7 fill-current">
              <path d="m12 3 2.78 5.63 6.22.9-4.5 4.39 1.06 6.2L12 17.2l-5.56 2.92 1.06-6.2L3 9.53l6.22-.9L12 3Z" />
            </svg>
          </div>
        </div>

        <div class="mt-5 flex items-center gap-1 text-lg text-amber-300" aria-label="5 out of 5 stars">
          <span>&#9733;</span><span>&#9733;</span><span>&#9733;</span><span>&#9733;</span><span>&#9733;</span>
        </div>

        <p class="mt-3 font-montserrat text-sm font-semibold text-white/75">Based on 15+ happy clients</p>

        <div class="mt-8 border-t border-white/10 pt-7">
          <p class="font-lexend text-[1.55rem] font-extrabold leading-tight text-white sm:text-[1.8rem]">
            Trusted by businesses across India, UK &amp; US.
          </p>

          <div class="mt-6 flex flex-wrap gap-2 font-montserrat text-xs font-bold uppercase tracking-[0.14em] text-white/60">
            <span class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-2">India</span>
            <span class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-2">United Kingdom</span>
            <span class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-2">United States</span>
          </div>
        </div>
      </div>

      <div class="relative min-w-0 rounded-[1.75rem] border border-white/10 bg-[#10264a]/80 p-5 shadow-[0_24px_80px_rgba(0,0,0,0.28)] backdrop-blur-sm sm:p-8 lg:p-10">
        <div class="flex items-center justify-between gap-4">
          <div class="flex items-center gap-2 font-montserrat text-xs font-bold uppercase tracking-[0.18em] text-cyan-300">
            <span class="h-2 w-2 rounded-full bg-cyan-300 shadow-[0_0_12px_rgba(39,244,239,0.9)]"></span>
            <span>Client story</span>
          </div>

          <div class="flex items-center gap-2">
            <button
              type="button"
              data-testimonials-prev
              aria-label="Previous testimonial"
              class="grid h-10 w-10 place-items-center rounded-full border border-white/15 bg-white/[0.04] text-2xl leading-none text-white/75 transition hover:border-cyan-300/50 hover:bg-cyan-300/10 hover:text-cyan-300"
            >
              &lsaquo;
            </button>
            <button
              type="button"
              data-testimonials-next
              aria-label="Next testimonial"
              class="grid h-10 w-10 place-items-center rounded-full border border-white/15 bg-white/[0.04] text-2xl leading-none text-white/75 transition hover:border-cyan-300/50 hover:bg-cyan-300/10 hover:text-cyan-300"
            >
              &rsaquo;
            </button>
          </div>
        </div>

        <div class="relative mt-6 min-h-[330px] sm:min-h-[300px]">
          {testimonials.map((testimonial, index) => (
            <article
              data-testimonial-slide
              data-active={index === 0}
              aria-live={index === 0 ? "polite" : undefined}
              class:list={[
                "absolute inset-0 flex flex-col justify-center transition-all duration-500 ease-out",
                index === 0 ? "translate-x-0 opacity-100" : "pointer-events-none translate-x-8 opacity-0",
              ]}
            >
              <div class="flex items-center gap-4">
                <div class={`grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-gradient-to-br ${testimonial.accent} font-lexend text-lg font-black text-[#06101f]`}>
                  {testimonial.initials}
                </div>
                <div>
                  <h3 class="font-lexend text-[1.35rem] font-extrabold leading-tight text-white sm:text-[1.6rem]">
                    {testimonial.name}
                  </h3>
                  <p class="mt-1 font-montserrat text-xs font-bold uppercase tracking-[0.13em] text-cyan-300/85">
                    {testimonial.role} <span class="text-white/35">•</span> {testimonial.company}
                  </p>
                </div>
              </div>

              <blockquote class="mt-8 font-montserrat text-[1.05rem] leading-8 text-white/85 sm:text-[1.15rem] sm:leading-9">
                <span aria-hidden="true" class="mr-1 font-serif text-4xl leading-0 text-cyan-300">“</span>{testimonial.quote}<span aria-hidden="true" class="ml-1 font-serif text-4xl leading-0 text-cyan-300">”</span>
              </blockquote>

              <div class="mt-7 flex items-center justify-between gap-4">
                <div class="flex items-center gap-1 text-amber-300" aria-label={`${testimonial.rating} out of 5 stars`}>
                  <span>&#9733;</span><span>&#9733;</span><span>&#9733;</span><span>&#9733;</span><span>&#9733;</span>
                </div>
                <span class="font-montserrat text-xs font-semibold uppercase tracking-[0.16em] text-white/40">Verified feedback</span>
              </div>
            </article>
          ))}
        </div>

        <div class="flex items-center justify-center gap-2 border-t border-white/10 pt-5">
          {testimonials.map((testimonial, index) => (
            <button
              type="button"
              data-testimonial-dot
              data-index={index}
              aria-label={`Show testimonial ${index + 1}`}
              aria-current={index === 0 ? "true" : "false"}
              class:list={[
                "h-2 rounded-full transition-all duration-300",
                index === 0 ? "w-7 bg-cyan-300 shadow-[0_0_12px_rgba(39,244,239,0.55)]" : "w-2 bg-white/25 hover:bg-white/50",
              ]}
            ></button>
          ))}
        </div>
      </div>
    </div>
  </div>

  <script>
    const initTestimonials = () => {
      const root = document.getElementById("testimonials");
      if (!root) {
        return;
      }

      const slides = Array.from(root.querySelectorAll("[data-testimonial-slide]"));
      const dots = Array.from(root.querySelectorAll("[data-testimonial-dot]"));
      const prevButtons = Array.from(root.querySelectorAll("[data-testimonials-prev]"));
      const nextButtons = Array.from(root.querySelectorAll("[data-testimonials-next]"));
      let activeIndex = 0;

      const showSlide = (nextIndex) => {
        activeIndex = (nextIndex + slides.length) % slides.length;

        slides.forEach((slide, index) => {
          const isActive = index === activeIndex;
          slide.dataset.active = String(isActive);
          slide.classList.toggle("opacity-100", isActive);
          slide.classList.toggle("translate-x-0", isActive);
          slide.classList.toggle("opacity-0", !isActive);
          slide.classList.toggle("translate-x-8", !isActive);
          slide.classList.toggle("pointer-events-none", !isActive);
          slide.setAttribute("aria-live", isActive ? "polite" : "off");
        });

        dots.forEach((dot, index) => {
          const isActive = index === activeIndex;
          dot.classList.toggle("w-7", isActive);
          dot.classList.toggle("bg-cyan-300", isActive);
          dot.classList.toggle("shadow-[0_0_12px_rgba(39,244,239,0.55)]", isActive);
          dot.classList.toggle("w-2", !isActive);
          dot.classList.toggle("bg-white/25", !isActive);
          dot.classList.toggle("shadow-none", !isActive);
          dot.setAttribute("aria-current", String(isActive));
        });
      };

      prevButtons.forEach((button) => {
        button.addEventListener("click", () => showSlide(activeIndex - 1));
      });

      nextButtons.forEach((button) => {
        button.addEventListener("click", () => showSlide(activeIndex + 1));
      });

      dots.forEach((dot) => {
        dot.addEventListener("click", () => {
          showSlide(Number(dot.dataset.index || 0));
        });
      });

      showSlide(0);
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initTestimonials, { once: true });
    } else {
      initTestimonials();
    }
  </script>
</section>
