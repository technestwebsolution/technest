---
const testimonials = [
  {
    name: "Rajat Khandelwal",
    role: "Founder, Retail Brand",
    company: "India",
    quote:
      "Amazing team and very strong communication. Technest understood our goals quickly and delivered a clean, fast platform that improved conversions within weeks.",
    rating: 5,
    accent: "from-[#27f4ef] to-[#10c0ff]",
    initials: "RK",
  },
  {
    name: "Sophia Mitchell",
    role: "Operations Director",
    company: "UK",
    quote:
      "The team handled design, development, and launch with real precision. They kept us updated at every step and solved issues before they became problems.",
    rating: 5,
    accent: "from-[#7f54b3] to-[#10c0ff]",
    initials: "SM",
  },
  {
    name: "Daniel Brooks",
    role: "CTO, SaaS Startup",
    company: "US",
    quote:
      "We needed a scalable product fast. Technest delivered a stable architecture, modern UI, and an implementation pace that kept our roadmap moving.",
    rating: 5,
    accent: "from-[#f76f1c] to-[#27f4ef]",
    initials: "DB",
  },
  {
    name: "Ayesha Khan",
    role: "Marketing Lead",
    company: "UAE",
    quote:
      "Clear thinking, strong execution, and a polished result. The new experience looks premium and has already improved engagement across our campaigns.",
    rating: 5,
    accent: "from-[#95bf47] to-[#10c0ff]",
    initials: "AK",
  },
];
---

<section
  id="testimonials"
  class="relative isolate overflow-hidden px-5 py-16 text-white lg:py-16"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0"
  ></div>

  <div class="relative mx-auto max-w-7xl">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-start">
      <div>
        <div class="mb-5 flex items-center gap-3 text-[0.82rem] font-bold uppercase tracking-[0.18em] text-cyan-300">
          <span class="h-px w-5 bg-cyan-300/80"></span>
          <span>What Our Clients Say</span>
          <span class="h-px w-5 bg-cyan-300/80"></span>
        </div>

        <h2 class="max-w-xl font-lexend text-[38px] font-extrabold leading-[1.16] text-white lg:text-[50px]">
          Our Work. Their Words.
        </h2>
      </div>

      <p class="max-w-2xl pt-1 font-montserrat text-[1.0rem] leading-8 text-white/82 lg:pt-16 lg:justify-self-end">
        Don&apos;t just take our word for it - hear directly from the businesses we&apos;ve helped build, launch, and grow their digital platforms.
      </p>
    </div>

    <div class="mt-14 grid gap-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:items-center">
      <div class="max-w-[24rem]">
        <div class="space-y-4">
          <div class="text-[4rem] font-lexend font-black leading-none text-white">
            4.9
          </div>
          <div class="flex items-center gap-1 text-amber-300">
            <span>&#9733;</span>
            <span>&#9733;</span>
            <span>&#9733;</span>
            <span>&#9733;</span>
            <span>&#9733;</span>
          </div>
          <p class="font-montserrat text-lg font-semibold text-white/90">
            (15+ Happy Clients)
          </p>
        </div>

        <h3 class="mt-5 font-lexend text-[2rem] font-extrabold leading-[1.05] text-white sm:text-[2.55rem]">
          Trusted by Businesses Across India, UK &amp; US.
        </h3>
      </div>

      <div class="relative">
        <div
          class="absolute inset-y-1/2 left-0 z-20 hidden -translate-x-1/2 -translate-y-1/2 lg:flex"
        >
          <button
            type="button"
            data-testimonials-prev
            aria-label="Previous testimonial"
            class="grid h-12 w-12 place-items-center rounded-full border border-white/15 bg-white/5 text-3xl text-white/82 transition hover:bg-white/10 hover:text-white"
          >
            &lsaquo;
          </button>
        </div>

        <div class="relative min-h-[320px] lg:min-h-[360px]">
          <div class="absolute inset-x-0 top-0 flex items-center justify-end gap-2 lg:hidden">
            <button
              type="button"
              data-testimonials-prev
              aria-label="Previous testimonial"
              class="grid h-11 w-11 place-items-center rounded-full border border-white/15 bg-white/5 text-3xl text-white/82 transition hover:bg-white/10 hover:text-white"
            >
              &lsaquo;
            </button>
            <button
              type="button"
              data-testimonials-next
              aria-label="Next testimonial"
              class="grid h-11 w-11 place-items-center rounded-full border border-white/15 bg-white/5 text-3xl text-white/82 transition hover:bg-white/10 hover:text-white"
            >
              &rsaquo;
            </button>
          </div>

          <div class="relative min-h-[260px] pt-16 lg:pt-0">
            {testimonials.map((testimonial, index) => (
              <article
                data-testimonial-slide
                data-active={index === 0}
                class:list={[
                  "absolute inset-0 flex items-center justify-center px-4 text-center transition-all duration-500 ease-out lg:px-12",
                  index === 0 ? "opacity-100 translate-x-0" : "pointer-events-none opacity-0 translate-x-8",
                ]}
              >
                <div class="max-w-3xl">
                  <h3 class="font-lexend text-[2rem] font-extrabold leading-tight text-white sm:text-[2.65rem] lg:text-[3rem]">
                    {testimonial.name}
                  </h3>
                  <p class="mt-5 font-montserrat text-[1rem] leading-8 text-white/88 sm:text-[1.08rem] lg:text-[1.12rem]">
                    {testimonial.quote}
                  </p>
                  <p class="mt-5 font-montserrat text-sm font-semibold uppercase tracking-[0.16em] text-cyan-300/90">
                    {testimonial.role} - {testimonial.company}
                  </p>
                  <div class="mt-7 flex items-center justify-center gap-2 text-amber-300">
                    <span>&#9733;</span>
                    <span>&#9733;</span>
                    <span>&#9733;</span>
                    <span>&#9733;</span>
                    <span>&#9733;</span>
                  </div>
                </div>
              </article>
            ))}
          </div>

          <div class="mt-10 flex items-center justify-center gap-3">
            {testimonials.map((testimonial, index) => (
              <button
                type="button"
                data-testimonial-dot
                data-index={index}
                aria-label={`Show testimonial ${index + 1}`}
                class:list={[
                  "h-2.5 rounded-full transition-all duration-300",
                  index === 0 ? "w-2.5 bg-[#0d0d0d] shadow-[0_0_10px_rgba(0,0,0,0.35)]" : "w-2.5 bg-white/18 hover:bg-white/32",
                ]}
              ></button>
            ))}
          </div>
        </div>

        <div
          class="absolute inset-y-1/2 right-0 z-20 hidden translate-x-1/2 -translate-y-1/2 lg:flex"
        >
          <button
            type="button"
            data-testimonials-next
            aria-label="Next testimonial"
            class="grid h-12 w-12 place-items-center rounded-full border border-white/15 bg-white/5 text-3xl text-white/82 transition hover:bg-white/10 hover:text-white"
          >
            &rsaquo;
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    const initTestimonials = () => {
      const root = document.getElementById("testimonials");
      if (!root) {
        return;
      }

      const slides = Array.from(root.querySelectorAll("[data-testimonial-slide]"));
      const dots = Array.from(root.querySelectorAll("[data-testimonial-dot]"));
      const prevButtons = Array.from(root.querySelectorAll("[data-testimonials-prev]"));
      const nextButtons = Array.from(root.querySelectorAll("[data-testimonials-next]"));
      let activeIndex = 0;

      const showSlide = (nextIndex) => {
        activeIndex = (nextIndex + slides.length) % slides.length;

        slides.forEach((slide, index) => {
          const isActive = index === activeIndex;
          slide.dataset.active = String(isActive);
          slide.classList.toggle("opacity-100", isActive);
          slide.classList.toggle("translate-x-0", isActive);
          slide.classList.toggle("opacity-0", !isActive);
          slide.classList.toggle("translate-x-8", !isActive);
          slide.classList.toggle("pointer-events-none", !isActive);
        });

        dots.forEach((dot, index) => {
          const isActive = index === activeIndex;
          dot.classList.toggle("bg-[#0d0d0d]", isActive);
          dot.classList.toggle("shadow-[0_0_10px_rgba(0,0,0,0.35)]", isActive);
          dot.classList.toggle("bg-white/18", !isActive);
          dot.classList.toggle("bg-white/32", !isActive);
        });
      };

      prevButtons.forEach((button) => {
        button.addEventListener("click", () => showSlide(activeIndex - 1));
      });

      nextButtons.forEach((button) => {
        button.addEventListener("click", () => showSlide(activeIndex + 1));
      });

      dots.forEach((dot) => {
        dot.addEventListener("click", () => {
          const index = Number(dot.dataset.index || 0);
          showSlide(index);
        });
      });

      showSlide(0);
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initTestimonials, { once: true });
    } else {
      initTestimonials();
    }
  </script>
</section>
